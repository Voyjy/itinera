# Itinera Frontend Environment Variables
# Create a .env file with these values for local development
# In Vercel, add VITE_API_URL in the project settings

# API URL - your backend URL
VITE_API_URL=http://localhost:5000

# For production (Vercel), set this to your Render backend URL:
# VITE_API_URL=https://itinera-backend.onrender.com
