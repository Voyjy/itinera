# Solea Docker Environment Variables
# Copy this file to .env and fill in your values

# MongoDB (for local Docker setup)
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=rootpassword
MONGO_URI=mongodb://root:rootpassword@mongo:27017/solea?authSource=admin

# Redis (for local Docker setup)
REDIS_URL=redis://redis:6379

# Neo4j (for local Docker setup)
NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password123

# JWT Secret
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Cloud Services (uncomment and use these for production)
# MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/solea
# REDIS_URL=redis://user:pass@redis-cloud.com:6379
# NEO4J_URI=neo4j+s://xxx.databases.neo4j.io
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=your-auradb-password
